{
  "manifest_version": 2,
  "name": "Leanback for Dropout",
  "version": "0.14.0",
  "description": "Drive watch.dropout.tv with arrow keys, Enter and Escape: a big focus ring, a theater player layout and media-key control for the couch",
  "browser_specific_settings": {
    "gecko": {
      "id": "leanback-for-dropout@inklikeurine.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "*://watch.dropout.tv/*",
    "*://embed.vhx.tv/*",
    "*://www.dropout.tv/*"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "lib/settings.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://watch.dropout.tv/*"
      ],
      "js": [
        "lib/settings.js",
        "nav/keymap.js",
        "nav/site-rules.js",
        "nav/spatial.js",
        "nav/focus-ring.js",
        "nav/menu.js",
        "content/page.js"
      ],
      "css": [
        "content/page.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://embed.vhx.tv/*"
      ],
      "js": [
        "lib/settings.js",
        "nav/keymap.js",
        "nav/site-rules.js",
        "nav/spatial.js",
        "nav/focus-ring.js",
        "content/transport.js",
        "content/player.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "css": [
        "content/player.css"
      ]
    },
    {
      "matches": [
        "*://www.dropout.tv/",
        "*://www.dropout.tv/?*"
      ],
      "js": [
        "lib/settings.js",
        "content/marketing.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Leanback for Dropout: click to turn TV navigation on or off"
  },
  "commands": {
    "toggle-tv-mode": {
      "description": "Turn Leanback for Dropout on or off"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
