{
  "site": "dropout",
  "browseUrl": "https://watch.dropout.tv/browse",
  "gridUrl": "https://watch.dropout.tv/series",
  "searchUrl": "https://watch.dropout.tv/search",
  "signinUrl": "https://watch.dropout.tv/login",
  "resetUrl": "https://watch.dropout.tv/forgot_password",
  "welcomeUrl": "https://watch.dropout.tv/",
  "signout": {
    "url": "https://watch.dropout.tv/logout",
    "token": "meta[name='csrf-token']"
  },
  "profileApi": {
    "profiles": "/v2/sites/{site}/users/{user}/profiles",
    "pictures": "/v2/sites/{site}/profile_pictures",
    "update": "/v2/sites/{site}/users/{user}/profiles/{index}",
    "after": "https://watch.dropout.tv/profile/pick?edit=1"
  },
  "legal": [
    {
      "label": "Privacy Policy",
      "url": "https://watch.dropout.tv/privacy"
    },
    {
      "label": "Terms of Use",
      "url": "https://watch.dropout.tv/tos"
    }
  ],
  "redirects": [
    {
      "path": "^/events/dropout-24-7/?$",
      "to": "https://watch.dropout.tv/dropout-24-7"
    }
  ],
  "routes": [
    {
      "kind": "welcome",
      "path": "^/$"
    },
    {
      "kind": "browse",
      "path": "^/browse/?$"
    },
    {
      "kind": "grid",
      "path": "^/(series|collections|my-list|movies|continue-watching)(/|$)"
    },
    {
      "kind": "video",
      "path": "/videos/[^/]+/?$"
    },
    {
      "kind": "video",
      "path": "^/[^/]+/events/[^/]+/?$"
    },
    {
      "kind": "search",
      "path": "^/search(/|$)"
    },
    {
      "kind": "profiles",
      "path": "^/profile/pick/?$"
    },
    {
      "kind": "signin",
      "path": "^/login/?$"
    },
    {
      "kind": "reset",
      "path": "^/forgot_password/?$"
    },
    {
      "kind": "legal",
      "path": "^/(privacy|tos|cookies)/?$"
    },
    {
      "kind": "profileEdit",
      "path": "^/settings/manage/profile/?$"
    },
    {
      "kind": "other",
      "path": "^/(login|logout|register|signup|checkout|contact|privacy|terms|help|settings|purchases|forgot|reset|gift|redeem|profile|account|activate|billing)(/|$)"
    },
    {
      "kind": "series",
      "path": "^/[^/]+(/season:\\d+)?/?$"
    }
  ],
  "common": {
    "header": ".site-header",
    "signedOut": "body.logged-out",
    "chrome": [
      ".site-header",
      "footer.footer--site"
    ],
    "focusable": [
      ".site-header a[href]"
    ],
    "modals": [
      ".reveal-modal.open",
      "[id^='ketch-']",
      "[class*='Modal-module__backdrop']",
      "[role='dialog'][data-state='open']"
    ],
    "modalStart": [
      "#ketch-purposes-modal [role='list'] button[aria-expanded]",
      "[role='dialog'] button[aria-pressed='true']",
      "[class*='Modal-module__panel'] button:has(img)",
      "#ketch-banner-button-primary"
    ],
    "modalClose": [
      ".close-reveal-modal",
      "[aria-label='Close']",
      "[role='dialog'] button[aria-label='Cancel']"
    ],
    "cookiePreferences": {
      "call": "showConsent",
      "hint": "experiences.consent.modal",
      "selector": ["a.manage-cookies-link"],
      "text": "^Manage Cookie Preferences$"
    },
    "hidden": [
      ".promo-banner"
    ],
    "hoverSuppress": [
      ".tooltip"
    ]
  },
  "pages": {
    "signin": {
      "box": "#login--box-container",
      "dropoutEmail": "#signin-email-input",
      "emailNext": "#signin-email-submit",
      "passwordInput": "#signin-password-input",
      "passwordHidden": ".signin-flow__password-form-container.signin-flow--hidden",
      "passwordSubmit": "#signin-password-submit",
      "nextMs": 15000,
      "signinMs": 20000,
      "error": ".flash-error-container .flash-msg-container",
      "errorText": ".flash-msg",
      "focusable": [
        ".tenfoot-signin input",
        ".tenfoot-signin button",
        ".tenfoot-signin a[href]"
      ]
    },
    "reset": {
      "box": "#login--box-container",
      "dropoutEmail": "#forgot-password-form #email",
      "send": "#forgot-password-form input[type='submit'], #forgot-password-form button[type='submit']",
      "error": ".flash-error-container .flash-msg-container",
      "errorText": ".flash-msg",
      "answerMs": 15000,
      "focusable": [
        ".tenfoot-signin input",
        ".tenfoot-signin button",
        ".tenfoot-signin a[href]"
      ]
    },
    "legal": {
      "content": "#customer-agreements, .primary-page-content",
      "hide": [
        ".promo-banner",
        "#search-react-app"
      ]
    },
    "profiles": {
      "focusable": [
        "#profile-picker-react-app input:not([type='hidden'])",
        "#profile-picker-react-app button",
        "#profile-picker-react-app a[href]"
      ],
      "initialFocus": [
        "#profile-picker-react-app input:not([type='hidden'])",
        "#profile-picker-react-app button"
      ]
    },
    "profileEdit": {
      "box": ".ProfileSettings-module__panel",
      "focusable": [
        ".ProfileSettings-module__panel [role='button']",
        ".ProfileSettings-module__panel input:not([type='hidden'])",
        ".ProfileSettings-module__panel button"
      ],
      "initialFocus": [
        "#profile-name"
      ],
      "hide": [
        ".SettingsNav-module__sidebar",
        ".Header-module__site-header",
        ".Footer-module__site-footer"
      ]
    },
    "browse": {
      "rows": ".horizontal-row-container, .carousel-layout-container",
      "rowItem": ".horizontal-row-item, .featured-carousel-slide",
      "target": "a[href]",
      "scrollNext": ".carousel-arrow--right",
      "scrollPrev": ".carousel-arrow--left",
      "initialFocus": ".horizontal-row-container .horizontal-row-item a[href]"
    },
    "grid": {
      "tile": ".browse-item-card",
      "target": "a.browse-item-link",
      "loadMore": "a.js-load-more-link, [data-load-more]",
      "initialFocus": ".browse-item-card a.browse-item-link"
    },
    "series": {
      "focusable": [
        "a.custom-btn-action-primary",
        "a.custom-btn-action-trailer",
        "button.custom-btn-action-my-list",
        "select.js-switch-season",
        "select.js-sort-items"
      ],
      "tile": ".browse-item-card",
      "target": "a.browse-item-link",
      "loadMore": "a.js-load-more-link, [data-load-more]",
      "episodeLinks": ".episode-container .browse-item-card a.browse-item-link",
      "initialFocus": [
        ".episode-container a.browse-item-link",
        ".browse-item-card a.browse-item-link"
      ],
      "show": {
        "layouts": {
          "show": "section.episode-container",
          "special": "section.movie-container",
          "list": "section.collection-container"
        },
        "seasonSelect": "select.js-switch-season",
        "episodeCount": ".season-controls .content-label",
        "episodes": "section.episode-container",
        "episode": "li.js-collection-item",
        "episodeLink": "a.browse-item-link",
        "episodeProgress": ".percentage-bar",
        "episodeNumber": ".media-episode",
        "episodeTitle": ".browse-item-title",
        "episodeImage": ".browse-image-container img",
        "episodeDuration": ".duration-container",
        "heroTitle": "h1.collection-title",
        "heroStats": "h2.collection-stats",
        "heroDescription": ".collection-description",
        "heroImage": ".cover-art img[data-image-primary]",
        "trailerAction": ".collection-actions a.custom-btn-action-trailer",
        "listAction": ".collection-actions button.custom-btn-action-my-list",
        "listed": ".icon-watchlist-remove",
        "movieSection": "section.movie-container",
        "extrasSection": "section.extras-container",
        "sectionTitle": "h2.collection-title, .extras-header",
        "more": "a.js-load-more-link",
        "primaryAction": ".custom-btn-action-primary"
      }
    },
    "video": {
      "theaterRoot": "#watch-player, #live-event",
      "playerMount": "#watch-player .embed, #live-event .embed",
      "playerFrame": "#watch-player iframe[src*='embed.vhx.tv'], #live-event iframe[src*='embed.vhx.tv']",
      "seriesLink": ".series-title a.context-link",
      "videoTitle": "#watch-info .video-title",
      "videoImage": "meta[property='og:image']",
      "live": "#live-event",
      "episodeInfo": "#watch-info a[href*='/season:']",
      "canonical": "meta[property='og:url']",
      "focusable": [
        "#watch-info a[href]",
        "a[data-similar-items-site]"
      ],
      "tile": ".browse-item-card",
      "target": "a.browse-item-link",
      "theaterHide": [
        ".site-header",
        ".promo-banner"
      ],
      "upNextOverlay": ".vp-outro-wrapper, [class*='Outro_module_outroWrapper'], .ott-up-next"
    },
    "search": {
      "focusable": [
        ".SearchForm-module__search-input",
        ".custom-css-search-input",
        "input:not([type='hidden']):not([type='checkbox']):not([type='radio']):not([type='submit']):not([type='button'])",
        "textarea",
        "[contenteditable='true']",
        ".Filters-module__filters-toggle",
        ".Filter-module__filter",
        ".Filter-module__subfilter",
        ".TypeFilters-module__type-filter"
      ],
      "tile": ".browse-item-card",
      "target": [
        "a.browse-item-link",
        "a[href]"
      ],
      "loadMore": ".SearchResults-module__load-more, .Filter-module__load-more, a.js-load-more-link",
      "initialFocus": [
        ".SearchForm-module__search-input",
        ".custom-css-search-input",
        "input:not([type='hidden']):not([type='checkbox']):not([type='radio']):not([type='submit']):not([type='button'])",
        "textarea",
        "[contenteditable='true']"
      ]
    },
    "other": {
      "focusable": [
        "a[href]",
        "button",
        "input",
        "select",
        "textarea"
      ]
    }
  },
  "player": {
    "video": "video",
    "transport": ".vp-controls",
    "transportItems": [
      "button",
      "[role='button']",
      "[role='menuitem']"
    ],
    "transportHide": [
      "[class*='VolumeControl_module_']",
      "[aria-label='Mute']",
      "[aria-label='Unmute']",
      "[aria-label*='olume']",
      "#pip-control-bar-button",
      "button.pip",
      "[class*='PictureInPicture']",
      "[aria-label*='icture']",
      "#transcript-control-bar-button",
      "[class*='transcript']",
      "[aria-label*='ranscript']",
      "[aria-label*='Vimeo AI']",
      "[class*='AIWidget_module_']"
    ],
    "upNextOverlay": ".vp-outro-wrapper, [class*='Outro_module_outroWrapper'], .ott-up-next",
    "upNextButton": "a.ott-up-next-thumb-link",
    "upNextHide": "button.ott-up-next-hide",
    "transportKeep": [
      "[class*='PlayButton_module_']",
      "#cc-control-bar-button",
      "[data-cc-button]",
      "button.cc",
      "[class*='CaptionsButton_module_']",
      "[aria-label*='aption']",
      "[aria-label*='ubtitle']",
      "#prefs-control-bar-button",
      "[class*='PrefsButton_module_']",
      ".vp-prefs",
      "[aria-label='Settings']",
      "#fullscreen-control-bar-button",
      "button.fullscreen",
      "[class*='FullscreenButton_module_']"
    ],
    "transportMenu": [
      ".vp-menu",
      "[class*='PopoverMenu_module_']",
      "[role='menu']"
    ],
    "chrome": [
      ".vp-controls",
      ".ott-up-next",
      "[class*='PlayButton_module_playButtonWrapper']",
      "[class*='PlayButton_module_playButton__']",
      ".vp-sidedock",
      ".vp-title",
      "[class*='AIWidget_module_']"
    ],
    "prefsButton": "#prefs-control-bar-button, .vp-prefs, [class*='PrefsButton_module_']",
    "fullscreenButton": "#fullscreen-control-bar-button, button.fullscreen, [class*='FullscreenButton_module_']",
    "menu": ".vp-menu, [class*='PopoverMenu_module_menu__']",
    "menuPanel": "[class*='PopoverMenu_module_menuPanel'], [role='menu']",
    "menuItem": "[data-menu-option='true'], [role='menuitem'], [role='menuitemradio'], li[role='radio'], [class*='Accordion_module'] [role='button'][aria-expanded]",
    "menuText": "[class*='Text_module_text']",
    "menuTitle": "[class*='MenuHeader_module_title']",
    "menuBack": "button[aria-label='Back']",
    "menuLabel": "[class*='MenuItem_module_label'], [class*='MenuOptionListItem_module_text'], [class*='ButtonRow_module_label']",
    "menuValue": "[class*='MenuItem_module_value']"
  },
  "live": {
    "path": "^/[^/]+/events/[^/]+/?$",
    "player": "#live-event iframe[src*='embed.vhx.tv']",
    "title": "#watch-info .live-event-title"
  },
  "rail": {
    "profile": {
      "picture": ".user-actions .avatar-container .avatar-user",
      "url": "https://watch.dropout.tv/profile/pick"
    },
    "kinds": [
      "browse",
      "hub",
      "grid",
      "search",
      "series",
      "video",
      "profiles",
      "profileEdit",
      "legal",
      "other"
    ],
    "links": [
      {
        "id": "my-list",
        "label": "My List",
        "icon": "bookmark",
        "url": "https://watch.dropout.tv/my-list"
      },
      {
        "id": "live",
        "label": "Dropout 24/7",
        "icon": "tv",
        "url": "https://watch.dropout.tv/dropout-24-7"
      }
    ]
  },
  "screen": {
    "root": "section.collection-container ul.js-load-more-items-container",
    "title": "h1.collection-title",
    "item": "li.js-collection-item",
    "itemLink": ".browse-item-card a[href]",
    "itemImage": ".browse-image-container img",
    "itemTitle": ".browse-item-title",
    "itemSubtext": ".browse-item-subtext",
    "itemDuration": ".duration-container",
    "itemProgress": ".percentage-bar",
    "itemBadge": "[data-testid^='thumbnail-badge-']",
    "more": "a.js-load-more-link",
    "search": {
      "input": "input.SearchForm-module__search-input",
      "filter": "button.TypeFilters-module__type-filter",
      "filterSelected": ".TypeFilters-module__selected",
      "root": "ul.SearchResults-module__search-results",
      "item": "li.SearchResults-module__search-result",
      "itemLink": "a[href]",
      "itemImage": ".browse-image-container img",
      "itemTitle": ".subtext-container .truncate",
      "itemSubtext": ".browse-item-subtext",
      "itemDuration": ".duration-container",
      "itemProgress": ".percentage-bar",
      "itemBadge": "[data-testid^='thumbnail-badge-']",
      "empty": ".BlankSearchResults-module__no-results",
      "more": "button.SearchResults-module__load-more"
    },
    "episode": {
      "title": "#watch-info .video-title, #watch-info .live-event-title",
      "show": "#watch-info .series-title a.context-link",
      "info": "#watch-info h5.badges-container",
      "season": "#watch-info h5.badges-container a[href*='/season:']",
      "description": "#watch-info .read-more-wrap > p, #watch-info .live-event-description > p",
      "listAction": "#watch-info .video-content-actions button.custom-btn-action-my-list",
      "listed": ".icon-watchlist-remove",
      "image": "meta[property='og:image']"
    },
    "profiles": {
      "root": "#profile-picker-react-app",
      "title": "h1",
      "row": "h1 + div",
      "profile": ":scope > button",
      "picture": "img",
      "name": ":scope > span",
      "add": "^Add Profile$",
      "toggle": "h1 ~ button",
      "done": "^Done$",
      "pin": {
        "boxes": "#profile-picker-react-app input[inputmode='numeric'], #profile-picker-react-app input[type='tel'], #profile-picker-react-app input[type='number'], [class*='LockedProfilePinScreen'] input:not([type='hidden'])",
        "submit": "[class*='LockedProfilePinScreen'] button[type='submit']"
      }
    },
    "profileForm": {
      "add": {
        "root": "#profile-picker-react-app",
        "title": "h1",
        "text": "h1 ~ p",
        "picture": "button",
        "image": "img",
        "letter": ":scope > span",
        "name": "input[aria-label='Profile name']",
        "buttons": [
          { "key": "cancel", "text": "^Cancel$", "label": "Cancel" },
          { "key": "continue", "text": "^Continue$", "label": "Continue", "primary": true }
        ]
      },
      "edit": {
        "root": "[data-testid='settings-content-column'], .ProfileSettings-module__panel",
        "title": "h2",
        "text": "h2 + p",
        "picture": "button[aria-label='Change profile picture'], [role='button'][aria-label='Change profile picture'], .ProfileSettings-module__avatar-wrapper",
        "image": "img",
        "letter": "span",
        "name": "#profile-name",
        "kid": "#profile-kid-mode, #child-mode, [role='switch']",
        "status": "[data-sonner-toast], [role='status']",
        "saveMs": 6000,
        "saveSettleMs": 800,
        "buttons": [
          { "key": "save", "text": "^Save$", "label": "Save", "primary": true, "save": true },
          { "key": "cancel", "text": "^Cancel$", "label": "Cancel", "ask": true },
          { "key": "delete", "text": "^Delete Profile$", "label": "Delete Profile", "danger": true, "ask": true }
        ],
        "dialog": "[role='dialog'], [role='alertdialog']",
        "confirm": "^Delete( Profile)?$"
      }
    },
    "welcome": {
      "root": ".hero--container",
      "logo": "h1.head-image img",
      "title": "h2",
      "text": "p.head-3",
      "note": "To start a subscription, go to dropout.tv on a phone or a computer."
    }
  },
  "home": {
    "root": "#browse-component",
    "slide": ".carousel .slide",
    "slideLink": ".slide-bg-img-wrapper a[href]",
    "slideImage": "img.slide-bg-img",
    "slideTitle": ".slide-title",
    "slideSubtitle": ".slide-subtitle",
    "slideDescription": ".slide-description",
    "slideButtons": ".slide-buttons a[href], .slide-buttons button",
    "slideList": ".slide-button--my-list",
    "slideListed": ".icon-watchlist-remove",
    "row": ".browse-row",
    "rowTitle": ".horizontal-row-header a:not(.view-more-link)",
    "rowViewAll": "a.view-more-link[href]",
    "item": ".slick-slide:not(.slick-cloned) .horizontal-row-item",
    "itemLink": ".browse-item-card a[href]",
    "itemImage": ".browse-image-container img",
    "itemPoster": ".browse-image-container.aspect_ratio_2_3",
    "itemWideArt": "data.thumbnail.medium",
    "itemTitle": ".subtext-container .truncate",
    "itemSubtext": ".browse-item-subtext",
    "itemDuration": ".duration-container",
    "itemProgress": "[data-testid='play-state-percentage-bar']",
    "itemBadge": "[data-testid^='thumbnail-badge-']",
    "rowPageSize": 12,
    "rowOverrides": {
      "/continue-watching": { "hidden": true },
      "/my-list": { "hidden": true },
      "/new-releases": { "badges": false }
    },
    "rowTitleOverrides": {
      "Continue Watching": { "hidden": true }
    },
    "showMore": ".see-more-row--show button"
  }
}
